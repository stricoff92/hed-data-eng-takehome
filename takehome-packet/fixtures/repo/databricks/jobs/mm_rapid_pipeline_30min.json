{
  "name": "mm_rapid_pipeline_30min",
  "tags": {
    "pipeline": "mm_rapid_pipeline_30min",
    "tier": "1"
  },
  "schedule": {
    "quartz_cron_expression": "0 0/30 * * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "main",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_D4s_v5",
        "num_workers": 2
      }
    }
  ],
  "tasks": [
    {
      "task_key": "main",
      "job_cluster_key": "main",
      "notebook_task": {
        "notebook_path": "/Repos/platform/notebooks/meeting_minutes/rapid_segments",
        "source": "GIT"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    }
  ],
  "git_source": {
    "git_url": "https://github.com/example/platform",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "email_notifications": {
    "on_failure": [
      "data-platform-alerts@hed.example"
    ]
  }
}
