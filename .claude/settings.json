{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read(takehome-packet)",
      "Read(takehome-packet/**)"
    ],
    "deny": [
      "Edit(takehome-packet)",
      "Edit(takehome-packet/**)",
      "Edit(DEV-LOG.md)",
      "Edit(**/DEV-LOG.md)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyWrite": [
        "takehome-packet",
        "DEV-LOG.md"
      ]
    }
  }
}
