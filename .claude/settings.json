{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read(takehome-packet)",
      "Read(takehome-packet/**)"
    ],
    "deny": [
      "Edit(takehome-packet)",
      "Edit(takehome-packet/**)",
      "Edit(DECISIONS.md)",
      "Edit(**/DECISIONS.md)",
      "Edit(AI-USAGE.md)",
      "Edit(**/AI-USAGE.md)",
      "Edit(.claude/settings.json)",
      "Edit(**/.claude/settings.json)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyWrite": [
        "takehome-packet",
        "DECISIONS.md",
        "AI-USAGE.md",
        ".claude/settings.json"
      ]
    }
  }
}
